# Copy to .env.local and fill in. NEVER commit .env.local.

# ---- What this deployment ships ----
# `blogger` is the public release agreed on 20 Aug: the blog writer only.
# Socials and the connectors are shown as coming soon and their routes and
# APIs are closed. Anything else (including leaving this unset) ships
# everything, which is what local development and the internal build want.
#
# There is no release branch — this variable IS the release. Set it on the
# production server and nowhere else.
#
# NEXT_PUBLIC_ prefix is required: the sidebar and the editor read it in the
# browser, so it has to be inlined at build time. That also means it is baked
# into the bundle — changing it needs a rebuild, not just a restart.
NEXT_PUBLIC_RELEASE_MODE=blogger

# ---- TiDB Cloud (MySQL-compatible) ----
# TiDB Cloud console -> your cluster -> Connect -> "Connect With" = General.
# Take the connection string and add the database name at the end of the path.
# TLS is required and is applied in code, so no ?ssl= parameter is needed here.
# Format: mysql://<user>:<password>@<host>:4000/<database>
DATABASE_URL=

# ---- Auth.js ----
# Generate one with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
# The app's own origin. Required in production; optional locally.
# Password reset links are built from this, so if it is wrong or missing in
# production, people receive links pointing at localhost.
AUTH_URL=http://localhost:3000

# ---- Resend (password reset email) ----
# Full walkthrough, including the DNS records: guide/resend-setup.md
#
# resend.com -> API Keys -> Create API Key. Sending permission is enough.
RESEND_API_KEY=re_...
#
# Must be an address on a domain you have VERIFIED in Resend. Resend rejects
# anything else, and that rejection is the first thing everyone hits.
# Until a domain is verified, Resend's shared sender works for testing:
#   EMAIL_FROM="Forward <onboarding@resend.dev>"
# but it can only deliver to the address that owns the Resend account.
EMAIL_FROM="Forward <no-reply@your-domain.com>"

# ---- Google SSO ----
# Google Cloud console -> APIs & Services -> Credentials -> OAuth client ID
# (type: Web application).
# Authorised redirect URI, local:      http://localhost:3000/api/auth/callback/google
# Authorised redirect URI, production: https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---- Claude (blog generation) ----
# Generation shells out to the Claude Code CLI, so it bills against a Claude
# subscription rather than API credits. Full setup: guide/claude-cli-auth.md
#
# Get the token by running `claude setup-token` on a machine where you are
# already logged in. It is long-lived and survives reboots.
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat...

# !! Do NOT set ANTHROPIC_API_KEY. It would shadow the subscription token and
# !! silently bill per token instead. The runner strips both it and
# !! ANTHROPIC_AUTH_TOKEN from the CLI's environment for the same reason.

# Path to the CLI if it is not on PATH (`which claude` to find it).
# CLAUDE_BIN=claude

# claude-opus-5 is the default. claude-sonnet-5 is faster and lighter on the
# subscription's limits; worth A/B-ing on real briefs.
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=high

# A subscription is one seat, so concurrency is the real ceiling — not cost.
# Requests past the limit queue; past the queue depth they are turned away with
# a "try again shortly" the editor shows. Raise only if the plan tolerates it.
CLAUDE_MAX_CONCURRENT=2
CLAUDE_QUEUE_DEPTH=20
CLAUDE_TIMEOUT_MS=240000
